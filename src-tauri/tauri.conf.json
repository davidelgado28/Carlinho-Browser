{
  "build": {
    "devPath": "../src",
    "distDir": "../src"
  },
  "package": {
    "productName": "Navegador Carlinho",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "category": "DeveloperTool",
      "copyright": "",
      "externalBin": [],
      "icon": [],
      "identifier": "com.carlinho.browser",
      "resources": [],
      "shortDescription": "",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": "default-src 'self' https: http: data: blob: 'unsafe-inline' 'unsafe-eval'"
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "Navegador Carlinho v2",
        "width": 1280,
        "decorations": true
      }
    ]
  }
}
